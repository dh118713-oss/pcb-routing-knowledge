{
  "schema_version": 1,
  "entries": [
    {
      "id": "CAND-RETURN-PATH",
      "rule_ids": [
        "BAS-001",
        "BAS-002"
      ],
      "scope_level": "general_physics",
      "conditions": [
        {
          "field": "net_role",
          "op": "in",
          "value": [
            "signal",
            "rf_feed",
            "clock",
            "memory_data",
            "memory_clock",
            "memory_ca",
            "analog_input"
          ]
        }
      ],
      "required_facts": [
        "board_revision",
        "net_id",
        "source_return",
        "load_return"
      ],
      "sources": [
        "BOOK-003"
      ],
      "explanation": "General signal/return analysis only; no RF band or universal via distance. Actual copper and layer transition still require inspection."
    },
    {
      "id": "CAND-POWER-PATH",
      "rule_ids": [
        "PWR-006"
      ],
      "scope_level": "structural",
      "conditions": [
        {
          "field": "net_role",
          "op": "in",
          "value": [
            "power",
            "power_return"
          ]
        }
      ],
      "required_facts": [
        "board_revision",
        "net_id",
        "current_waveform",
        "finished_copper_um",
        "drop_budget",
        "thermal_budget"
      ],
      "sources": [
        "VENDOR-TI-SNVA021",
        "VENDOR-TI-SLVA773"
      ],
      "explanation": "Power sizing input check; no fixed mm/A or via/A rule."
    },
    {
      "id": "CAND-TI-CC2652R-RF",
      "rule_ids": [
        "RF-001",
        "HS-006"
      ],
      "scope_level": "device_specific",
      "conditions": [
        {
          "field": "net_role",
          "op": "eq",
          "value": "rf_feed"
        },
        {
          "field": "device_model",
          "op": "eq",
          "value": "CC2652R"
        },
        {
          "field": "package",
          "op": "eq",
          "value": "RGZ-VQFN48"
        },
        {
          "field": "technology",
          "op": "in",
          "value": [
            "BLE",
            "IEEE802.15.4",
            "Thread",
            "Zigbee",
            "TI-proprietary-2G4"
          ]
        },
        {
          "field": "frequency_hz",
          "op": "range_within",
          "value": {
            "min": 2360000000,
            "max": 2500000000,
            "unit": "Hz"
          }
        }
      ],
      "required_facts": [
        "board_revision",
        "component_ref",
        "net_id",
        "reference_design_revision",
        "stackup_revision",
        "antenna_implementation"
      ],
      "sources": [
        "DATASHEET-TI-CC2652R",
        "VENDOR-TI-SWRA640"
      ],
      "explanation": "Frequency is datasheet silicon range, not regulatory permission. Candidate only for the RF path of this exact part/package and supported protocol family; matching, reference-board and RF geometry still need review."
    },
    {
      "id": "CAND-TI-CC1310-HIGH-SUB1-RF",
      "rule_ids": [
        "RF-001",
        "HS-006"
      ],
      "scope_level": "device_specific",
      "conditions": [
        {
          "field": "net_role",
          "op": "eq",
          "value": "rf_feed"
        },
        {
          "field": "device_model",
          "op": "eq",
          "value": "CC1310"
        },
        {
          "field": "package",
          "op": "in",
          "value": [
            "RGZ-VQFN48",
            "RHB-VQFN32",
            "RSM-VQFN32"
          ]
        },
        {
          "field": "technology",
          "op": "in",
          "value": [
            "TI-proprietary-sub1",
            "IEEE802.15.4g",
            "Wireless-MBus",
            "Wi-SUN"
          ]
        },
        {
          "field": "frequency_hz",
          "op": "range_within",
          "value": {
            "min": 861000000,
            "max": 1054000000,
            "unit": "Hz"
          }
        }
      ],
      "required_facts": [
        "board_revision",
        "component_ref",
        "net_id",
        "reference_design_revision",
        "stackup_revision",
        "antenna_implementation"
      ],
      "sources": [
        "DATASHEET-TI-CC1310",
        "VENDOR-TI-SWRA640"
      ],
      "explanation": "This entry intentionally covers only one listed CC1310 RF range. Other supported ranges require separately reviewed entries; never treat exclusion as proof that a component cannot work. No antenna, matching or routing dimensions transferred."
    },
